APP_NAME=Ask My Work
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL is the only relational database used by Ask My Work.
POSTGRES_DB=ask_my_work
POSTGRES_USER=ask_my_work
POSTGRES_PASSWORD=change-me
POSTGRES_URL=postgresql://ask_my_work:change-me@postgres:5432/ask_my_work

# Qdrant is the only vector database.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=ask_my_work

# Ollama already runs on the local host; it is NOT a Compose service.
# Override this value if your Docker-to-host networking uses another address.
OLLAMA_URL=http://host.docker.internal:11434
CHAT_MODEL=qwen3:4b
EMBED_MODEL=nomic-embed-text

TOP_K=5
